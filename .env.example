# Copy to .env for local runs outside Docker. Defaults shown.
DATABASE_URL=sqlite:///./scissors.sqlite
# Empty keeps the redirect cache and rate limits in memory (fine for one local process).
REDIS_URL=
RATE_LIMIT_CREATE=20/minute
RATE_LIMIT_MANAGE=60/minute
RATE_LIMIT_QR=60/minute
REDIRECT_CACHE_TTL=86400
# Other hostnames this app is served on, comma-separated; links to them are refused.
PUBLIC_HOSTS=
